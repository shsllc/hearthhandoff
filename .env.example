# Copy to .env and fill in locally. Never commit .env. Never paste these values into chat.

# --- App ---
PORT=3000
# Public HTTPS base URL when deployed (used to print the URLs to register in the Ring portal).
PUBLIC_BASE_URL=http://localhost:3000
# 32+ random bytes, base64. Signs session cookies and encrypts stored Ring tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=
# Enables the demo sign-in picker and the local webhook replay endpoint. Set false in production.
DEMO_MODE=true
# Days to keep door-event metadata that is not attached to a visit (attached events follow the visit).
RETENTION_DAYS=7
# How often (seconds) the background worker checks deadlines and polls Ring event history.
WORKER_INTERVAL_SECONDS=30

# --- Ring: option A, Developer Playground (no device, 30-minute token, read-only) ---
# https://developer.amazon.com/ring/console/playground -> Generate token
RING_ACCESS_TOKEN=

# --- Ring: option B, registered app (private or staging), real account linking + webhooks ---
# Issued once when you create the app in https://developer.amazon.com/ring/console/apps
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
